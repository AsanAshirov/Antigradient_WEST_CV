{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "fluid": true,
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,.venv/**,tests/**,test-results/**,public/**,dist/**,src/**,.git/**,server/test_*.py}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/scanner",
      "destination": "/index.html"
    },
    {
      "source": "/compare",
      "destination": "/index.html"
    },
    {
      "source": "/journey",
      "destination": "/index.html"
    },
    {
      "source": "/reports",
      "destination": "/index.html"
    },
    {
      "source": "/analytics",
      "destination": "/index.html"
    },
    {
      "source": "/technology",
      "destination": "/index.html"
    },
    {
      "source": "/business",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/demo",
      "destination": "https://azamaka-carprint-demo.hf.space/",
      "permanent": false
    },
    {
      "source": "/test",
      "destination": "https://azamaka-carprint-demo.hf.space/",
      "permanent": false
    },
    {
      "source": "/hf",
      "destination": "https://huggingface.co/spaces/Azamaka/carprint-demo",
      "permanent": false
    }
  ]
}
